# ============================================================================
# ECOVERSE 360 — Environment Configuration
# ============================================================================

# Application
APP_NAME=Ecoverse360
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://ecoverse:ecoverse360@localhost:5432/ecoverse360
DATABASE_SYNC_URL=postgresql://ecoverse:ecoverse360@localhost:5432/ecoverse360

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecoverse
MQTT_PASSWORD=ecoverse360

# JWT Auth
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ML Models
ML_MODEL_PATH=./ml_models
PREDICTION_INTERVAL_MINUTES=15

# EcoPoints
DEFAULT_RECYCLE_POINTS=10
DEFAULT_CARPOOL_POINTS=15
DEFAULT_BIN_DEPOSIT_POINTS=5
DEFAULT_WORKSHOP_POINTS=25
DEFAULT_SENSOR_DEPLOY_POINTS=50
DEFAULT_TREE_PLANT_POINTS=30
DEFAULT_CHALLENGE_POINTS=20

# Logging
LOG_LEVEL=INFO
